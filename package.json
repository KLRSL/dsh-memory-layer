{
  "name": "dsh-memory-layer",
  "description": "Remembers preferences and decisions across sessions and brings them back in new ones; data stays on your machine.",
  "version": "0.10.1",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "license": "MIT",
  "files": [
    "index.mjs",
    "db.mjs",
    "shared.mjs",
    "store.mjs",
    "retrieve.mjs",
    "trigger.mjs",
    "compact.mjs",
    "recall.mjs",
    "snapshot.mjs",
    "gate.mjs",
    "session-state.mjs",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KLRSL/dsh-memory-layer.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "plugin",
    "memory-layer",
    "sqlite",
    "local-first"
  ],
  "homepage": "https://github.com/KLRSL/dsh-memory-layer#readme",
  "bugs": {
    "url": "https://github.com/KLRSL/dsh-memory-layer/issues"
  },
  "dependencies": {}
}
